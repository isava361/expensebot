# Install as /etc/expensebot/expensebot.env, root:root, mode 0600.
BOT_TOKEN=REPLACE_WITH_NEW_EXPENSE_BOT_TOKEN
DB_PATH=/var/lib/expensebot/data.db
STATE_PATH=/var/lib/expensebot/bot_state.pickle
BACKUP_DIR=/var/lib/expensebot/backups
BACKUP_INTERVAL=86400
DEFAULT_CURRENCY=RUB
DEFAULT_TZ_OFFSET=+03:00
MINIAPP_URL=https://expense.ivansavelyev.ru:8443/
# Candidate only. Check ss and bind before installing; update Nginx too.
MINIAPP_PORT=18082
INIT_DATA_MAX_AGE=3600
